NEXT_PUBLIC_API_URL=http://localhost:3000

# Chave da Anthropic, usada pelo chat da doutora.
ANTHROPIC_API_KEY=

# Credenciais da ZuckPay, usadas para gerar o PIX e consultar o pagamento.
# Pegue em: ZuckPay > Desenvolvedores > Credenciais API.
ZUCKPAY_CLIENT_ID=
ZUCKPAY_CLIENT_SECRET=

# Segredo do postback, se a conta tiver um. Com ele, o aviso de pagamento
# é autenticado antes de ser processado. Sem ele o funil continua
# funcionando: a confirmação vem da consulta à própria ZuckPay.
ZUCKPAY_WEBHOOK_SECRET=

# Token da IronPay. Só é necessário enquanto houver PIX antigo pendente,
# gerado antes da troca de gateway.
IRONPAY_API_TOKEN=
